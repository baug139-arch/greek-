{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User accounts with roles (teacher, student) and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher", "student"] },
        "greekAlias": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "students": {
      "title": "Student Learning Profiles",
      "description": "Full student learning state, XP, SRS word mastery, assigned homework, attempts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "greekAlias": { "type": "string" },
        "avatar": { "type": "string" },
        "xp": { "type": "number" },
        "streakDays": { "type": "number" },
        "lastActive": { "type": "string" },
        "accuracyRate": { "type": "number" },
        "masteredWordsCount": { "type": "number" },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "completedChunks": { "type": "object" },
        "assignedHomework": { "type": "array" },
        "wordMastery": { "type": "object" },
        "recentMistakes": { "type": "array" },
        "sessionAttempts": { "type": "array" },
        "settings": { "type": "object" }
      },
      "required": ["id", "name"]
    },
    "custom_lists": {
      "title": "Teacher Custom Word Lists",
      "description": "Custom vocab lists curated by the teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "wordIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "assignedToAll": { "type": "boolean" }
      },
      "required": ["id", "title", "wordIds"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}"
}
